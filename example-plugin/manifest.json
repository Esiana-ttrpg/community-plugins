{
  "id": "example-plugin",
  "name": "Example Plugin",
  "version": "1.0.0",
  "description": "Reference plugin demonstrating global scope, configTemplate fields, and runtime entry points.",
  "scope": "global",
  "category": "utility",
  "license": "MIT",
  "engines": { "esiana-core": "^0.8.0" },
  "permissions": ["plugin:data", "data:interceptor", "ui:slot"],
  "uiSlots": ["sidebar", "header"],
  "configSchema": {
    "type": "object",
    "properties": {
      "greeting": {
        "type": "string",
        "title": "Greeting message",
        "description": "Hello from example-plugin",
        "default": "Hello from example-plugin"
      },
      "enableDebugRoute": {
        "type": "boolean",
        "title": "Expose debug route",
        "default": true
      }
    }
  },
  "configTemplate": [
    {
      "key": "greeting",
      "label": "Greeting message",
      "type": "text",
      "placeholder": "Hello from example-plugin",
      "defaultValue": "Hello from example-plugin"
    },
    {
      "key": "enableDebugRoute",
      "label": "Expose debug route",
      "type": "checkbox",
      "defaultValue": true
    }
  ],
  "githubUrl": "https://github.com/Esiana-ttrpg/community-plugins/tree/main/example-plugin",
  "backendEntry": "backend/index.js",
  "frontendEntry": "frontend/index.js"
}

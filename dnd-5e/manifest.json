{
  "id": "dnd-5e",
  "name": "D&D 5e Character Sheet",
  "version": "0.3.0",
  "description": "A complete D&D 5e character sheet with multiclass-friendly spellcasting, backed by portable Esiana CharacterFields.",
  "scope": "campaign",
  "category": "utility",
  "engines": {
    "esiana-core": ">=1.5.0"
  },
  "permissions": ["ui:slot"],
  "frontendEntry": "frontend/index.js",
  "characterPages": [
    {
      "key": "main-sheet",
      "title": "5e Character Sheet",
      "renderMode": "PLUGIN",
      "renderer": "main-sheet",
      "schemaVersion": 1,
      "fields": [
        { "key": "ability-strength", "label": "Strength", "type": "NUMBER", "defaultValue": 10, "validation": { "required": true, "min": 1, "max": 30 } },
        { "key": "ability-dexterity", "label": "Dexterity", "type": "NUMBER", "defaultValue": 10, "validation": { "required": true, "min": 1, "max": 30 } },
        { "key": "ability-constitution", "label": "Constitution", "type": "NUMBER", "defaultValue": 10, "validation": { "required": true, "min": 1, "max": 30 } },
        { "key": "ability-intelligence", "label": "Intelligence", "type": "NUMBER", "defaultValue": 10, "validation": { "required": true, "min": 1, "max": 30 } },
        { "key": "ability-wisdom", "label": "Wisdom", "type": "NUMBER", "defaultValue": 10, "validation": { "required": true, "min": 1, "max": 30 } },
        { "key": "ability-charisma", "label": "Charisma", "type": "NUMBER", "defaultValue": 10, "validation": { "required": true, "min": 1, "max": 30 } },
        { "key": "character-level", "label": "Level", "type": "NUMBER", "defaultValue": 1, "validation": { "required": true, "min": 1, "max": 20 } },
        { "key": "character-class", "label": "Class", "type": "STRING", "defaultValue": "", "validation": { "maxLength": 100 } },
        { "key": "character-subclass", "label": "Subclass", "type": "STRING", "defaultValue": "", "validation": { "maxLength": 100 } },
        { "key": "character-background", "label": "Background", "type": "STRING", "defaultValue": "", "validation": { "maxLength": 100 } },
        { "key": "character-alignment", "label": "Alignment", "type": "ENUM", "defaultValue": "UNALIGNED", "validation": { "required": true, "options": ["LAWFUL_GOOD", "NEUTRAL_GOOD", "CHAOTIC_GOOD", "LAWFUL_NEUTRAL", "TRUE_NEUTRAL", "CHAOTIC_NEUTRAL", "LAWFUL_EVIL", "NEUTRAL_EVIL", "CHAOTIC_EVIL", "UNALIGNED"] } },
        { "key": "experience-points", "label": "Experience Points", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99999999 } },
        { "key": "inspiration", "label": "Inspiration", "type": "BOOLEAN", "defaultValue": false },
        { "key": "combat-ac", "label": "Armor Class", "type": "NUMBER", "defaultValue": 10, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "combat-speed", "label": "Speed", "type": "NUMBER", "defaultValue": 30, "validation": { "required": true, "min": 0, "max": 999 } },
        { "key": "combat-initiative-bonus", "label": "Initiative Bonus", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": -99, "max": 99 } },
        { "key": "hp-current", "label": "Current Hit Points", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 9999 } },
        { "key": "hp-maximum", "label": "Maximum Hit Points", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 9999 } },
        { "key": "hp-temporary", "label": "Temporary Hit Points", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 9999 } },
        { "key": "save-strength", "label": "Strength Save Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT"] } },
        { "key": "save-dexterity", "label": "Dexterity Save Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT"] } },
        { "key": "save-constitution", "label": "Constitution Save Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT"] } },
        { "key": "save-intelligence", "label": "Intelligence Save Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT"] } },
        { "key": "save-wisdom", "label": "Wisdom Save Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT"] } },
        { "key": "save-charisma", "label": "Charisma Save Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT"] } },
        { "key": "skill-acrobatics", "label": "Acrobatics Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-animal-handling", "label": "Animal Handling Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-arcana", "label": "Arcana Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-athletics", "label": "Athletics Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-deception", "label": "Deception Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-history", "label": "History Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-insight", "label": "Insight Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-intimidation", "label": "Intimidation Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-investigation", "label": "Investigation Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-medicine", "label": "Medicine Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-nature", "label": "Nature Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-perception", "label": "Perception Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-performance", "label": "Performance Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-persuasion", "label": "Persuasion Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-religion", "label": "Religion Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-sleight-of-hand", "label": "Sleight of Hand Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-stealth", "label": "Stealth Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "skill-survival", "label": "Survival Proficiency", "type": "ENUM", "defaultValue": "NONE", "validation": { "required": true, "options": ["NONE", "PROFICIENT", "EXPERTISE"] } },
        { "key": "hit-die", "label": "Hit Die", "type": "ENUM", "defaultValue": "D8", "validation": { "required": true, "options": ["D6", "D8", "D10", "D12"] } },
        { "key": "hit-dice-current", "label": "Current Hit Dice", "type": "NUMBER", "defaultValue": 1, "validation": { "required": true, "min": 0, "max": 20 } },
        { "key": "death-save-successes", "label": "Death Save Successes", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 3 } },
        { "key": "death-save-failures", "label": "Death Save Failures", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 3 } },
        { "key": "senses", "label": "Senses", "type": "STRING", "defaultValue": "", "validation": { "maxLength": 500 } },
        { "key": "currency-copper", "label": "Copper Pieces", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 9999999 } },
        { "key": "currency-silver", "label": "Silver Pieces", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 9999999 } },
        { "key": "currency-electrum", "label": "Electrum Pieces", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 9999999 } },
        { "key": "currency-gold", "label": "Gold Pieces", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 9999999 } },
        { "key": "currency-platinum", "label": "Platinum Pieces", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 9999999 } },
        { "key": "attacks", "label": "Attacks", "type": "JSON", "defaultValue": { "version": 1, "entries": [] } },
        { "key": "equipment", "label": "Equipment", "type": "JSON", "defaultValue": { "version": 1, "entries": [] } },
        { "key": "features", "label": "Features and Traits", "type": "JSON", "defaultValue": { "version": 1, "entries": [] } },
        { "key": "proficiencies-languages", "label": "Proficiencies and Languages", "type": "JSON", "defaultValue": { "version": 1, "entries": [] } }
      ]
    },
    {
      "key": "spellcasting",
      "title": "Spellcasting",
      "renderMode": "PLUGIN",
      "renderer": "spellcasting",
      "schemaVersion": 1,
      "fields": [
        { "key": "spellcasting-sources", "label": "Spellcasting Sources", "type": "JSON", "defaultValue": { "version": 1, "entries": [] } },
        { "key": "spells", "label": "Spells", "type": "JSON", "defaultValue": { "version": 1, "entries": [] } },
        { "key": "spell-slots-1-maximum", "label": "Level 1 Spell Slots Maximum", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-1-remaining", "label": "Level 1 Spell Slots Remaining", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-2-maximum", "label": "Level 2 Spell Slots Maximum", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-2-remaining", "label": "Level 2 Spell Slots Remaining", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-3-maximum", "label": "Level 3 Spell Slots Maximum", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-3-remaining", "label": "Level 3 Spell Slots Remaining", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-4-maximum", "label": "Level 4 Spell Slots Maximum", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-4-remaining", "label": "Level 4 Spell Slots Remaining", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-5-maximum", "label": "Level 5 Spell Slots Maximum", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-5-remaining", "label": "Level 5 Spell Slots Remaining", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-6-maximum", "label": "Level 6 Spell Slots Maximum", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-6-remaining", "label": "Level 6 Spell Slots Remaining", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-7-maximum", "label": "Level 7 Spell Slots Maximum", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-7-remaining", "label": "Level 7 Spell Slots Remaining", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-8-maximum", "label": "Level 8 Spell Slots Maximum", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-8-remaining", "label": "Level 8 Spell Slots Remaining", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-9-maximum", "label": "Level 9 Spell Slots Maximum", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } },
        { "key": "spell-slots-9-remaining", "label": "Level 9 Spell Slots Remaining", "type": "NUMBER", "defaultValue": 0, "validation": { "required": true, "min": 0, "max": 99 } }
      ]
    }
  ]
}
